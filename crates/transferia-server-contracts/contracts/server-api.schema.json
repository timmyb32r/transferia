{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ServerApiContract",
  "type": "object",
  "properties": {
    "catalog_response": {
      "$ref": "#/$defs/UiCatalog"
    },
    "delivery_list_response": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/DeliverySummary"
      }
    },
    "delivery_response": {
      "$ref": "#/$defs/DeliveryRecord"
    },
    "discovery_response": {
      "$ref": "#/$defs/DiscoveryResult"
    },
    "validation_response": {
      "$ref": "#/$defs/ValidationCommandResult"
    },
    "dynamic_options_response": {
      "$ref": "#/$defs/DynamicOptions"
    },
    "dynamic_options_request": {
      "$ref": "#/$defs/OptionsRequest"
    },
    "connection_check_request": {
      "$ref": "#/$defs/ConnectionCheckRequest"
    },
    "connection_check_response": {
      "$ref": "#/$defs/ConnectionCheckResult"
    },
    "message_preview_request": {
      "$ref": "#/$defs/MessagePreviewRequest"
    },
    "message_preview_response": {
      "$ref": "#/$defs/MessagePreviewResult"
    },
    "sql_playground_request": {
      "$ref": "#/$defs/SqlPlaygroundRequest"
    },
    "sql_playground_response": {
      "$ref": "#/$defs/SqlPlaygroundResult"
    },
    "yaml_response": {
      "$ref": "#/$defs/YamlResponse"
    },
    "config_response": {
      "$ref": "#/$defs/ConfigResponse"
    },
    "health_response": {
      "$ref": "#/$defs/HealthResponse"
    },
    "error_response": {
      "$ref": "#/$defs/ApiErrorBody"
    },
    "config_request": {
      "$ref": "#/$defs/ConfigRequest"
    },
    "yaml_request": {
      "$ref": "#/$defs/YamlRequest"
    },
    "create_draft_request": {
      "$ref": "#/$defs/CreateDraftRequest"
    },
    "update_draft_request": {
      "$ref": "#/$defs/UpdateDraftRequest"
    },
    "revision_request": {
      "$ref": "#/$defs/RevisionRequest"
    },
    "stop_request": {
      "$ref": "#/$defs/StopRequest"
    },
    "worker_logs_response": {
      "$ref": "#/$defs/WorkerLogsResult"
    },
    "worker_log_response": {
      "$ref": "#/$defs/WorkerLogChunkView"
    },
    "worker_log_read_query": {
      "$ref": "#/$defs/WorkerLogReadQuery"
    }
  },
  "required": [
    "catalog_response",
    "delivery_list_response",
    "delivery_response",
    "discovery_response",
    "validation_response",
    "dynamic_options_response",
    "dynamic_options_request",
    "connection_check_request",
    "connection_check_response",
    "message_preview_request",
    "message_preview_response",
    "sql_playground_request",
    "sql_playground_response",
    "yaml_response",
    "config_response",
    "health_response",
    "error_response",
    "config_request",
    "yaml_request",
    "create_draft_request",
    "update_draft_request",
    "revision_request",
    "stop_request",
    "worker_logs_response",
    "worker_log_response",
    "worker_log_read_query"
  ],
  "$defs": {
    "UiCatalog": {
      "type": "object",
      "properties": {
        "common_schema": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonSchema"
        },
        "initial": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonObject"
        },
        "providers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderDefinition"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "common_schema",
        "initial",
        "providers"
      ]
    },
    "ProviderDefinition": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointDefinition"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        },
        "sink": {
          "anyOf": [
            {
              "$ref": "#/$defs/EndpointDefinition"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "title"
      ]
    },
    "EndpointDefinition": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonSchema"
        },
        "initial": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonObject"
        },
        "delivery_modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeliveryMode"
          }
        },
        "partitioned": {
          "type": "boolean"
        },
        "connection_check": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema",
        "initial",
        "delivery_modes",
        "partitioned",
        "connection_check"
      ]
    },
    "DeliveryMode": {
      "type": "string",
      "enum": [
        "batch",
        "stream"
      ]
    },
    "DeliverySummary": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "validation": {
          "$ref": "#/$defs/ValidationState"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeState"
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "revision",
        "validation",
        "runtime",
        "updated_at_ms"
      ]
    },
    "ValidationState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "draft"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "ready"
            }
          },
          "required": [
            "state",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "invalid"
            }
          },
          "required": [
            "state",
            "revision",
            "message"
          ]
        }
      ]
    },
    "RuntimeState": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "created"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "stopped"
            }
          },
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "starting"
            }
          },
          "required": [
            "state",
            "run_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "pid": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "state": {
              "type": "string",
              "const": "running"
            }
          },
          "required": [
            "state",
            "run_id",
            "pid"
          ]
        },
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "stopping"
            }
          },
          "required": [
            "state",
            "run_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "run_id": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "failed"
            }
          },
          "required": [
            "state",
            "run_id",
            "message"
          ]
        }
      ]
    },
    "DeliveryRecord": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonObject"
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "record_version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)$"
        },
        "validation": {
          "$ref": "#/$defs/ValidationState"
        },
        "runtime": {
          "$ref": "#/$defs/RuntimeState"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updated_at_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "config",
        "revision",
        "record_version",
        "validation",
        "runtime",
        "created_at_ms",
        "updated_at_ms"
      ]
    },
    "DiscoveryResult": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "sink": {
          "type": "string"
        },
        "pipeline_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DatasetView"
          }
        },
        "sink_limits": {
          "$ref": "#/$defs/SinkLimitsDescription"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "sink",
        "pipeline_count",
        "datasets",
        "sink_limits"
      ]
    },
    "DatasetView": {
      "type": "object",
      "properties": {
        "role": {
          "$ref": "#/$defs/DatasetRoleView"
        },
        "name": {
          "type": "string"
        },
        "intermediate_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ColumnView"
          }
        },
        "final_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DestinationColumnView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "role",
        "name",
        "intermediate_columns",
        "final_columns"
      ]
    },
    "DatasetRoleView": {
      "type": "string",
      "enum": [
        "Main",
        "DeadLetterQueue"
      ]
    },
    "ColumnView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arrow_type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "primary_key": {
          "type": "boolean"
        },
        "low_cardinality": {
          "type": "boolean"
        },
        "max_length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "arrow_type",
        "nullable",
        "primary_key",
        "low_cardinality"
      ]
    },
    "DestinationColumnView": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "arrow_type": {
          "type": "string"
        },
        "nullable": {
          "type": "boolean"
        },
        "primary_key": {
          "type": "boolean"
        },
        "low_cardinality": {
          "type": "boolean"
        },
        "max_length": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "x-omit-none": true
        },
        "destination_type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "arrow_type",
        "nullable",
        "primary_key",
        "low_cardinality",
        "destination_type"
      ]
    },
    "SinkLimitsDescription": {
      "description": "Machine-readable summary of the restrictions enforced by one sink.",
      "type": "object",
      "properties": {
        "sink": {
          "type": "string"
        },
        "dataset_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextLimit"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        },
        "column_name": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextLimit"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        },
        "supported_arrow_types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ArrowTypeFamily"
          }
        },
        "object_key": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectKeyLimit"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "sink",
        "supported_arrow_types"
      ]
    },
    "TextLimit": {
      "type": "object",
      "properties": {
        "syntax": {
          "$ref": "#/$defs/NameSyntax"
        },
        "max_utf8_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0,
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "syntax"
      ]
    },
    "NameSyntax": {
      "type": "string",
      "enum": [
        "any_non_empty_utf8",
        "ascii_identifier",
        "object_store_path_segment"
      ]
    },
    "ArrowTypeFamily": {
      "type": "string",
      "enum": [
        "utf8",
        "binary",
        "signed_integer",
        "unsigned_integer",
        "floating_point",
        "decimal",
        "boolean",
        "date32",
        "date64",
        "timestamp"
      ]
    },
    "ObjectKeyLimit": {
      "type": "object",
      "properties": {
        "max_utf8_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "normalized_relative_path": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "max_utf8_bytes",
        "normalized_relative_path"
      ]
    },
    "ValidationCommandResult": {
      "type": "object",
      "properties": {
        "delivery": {
          "$ref": "#/$defs/DeliveryRecord"
        },
        "discovery": {
          "anyOf": [
            {
              "$ref": "#/$defs/DiscoveryResult"
            },
            {
              "type": "null"
            }
          ],
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "delivery"
      ]
    },
    "DynamicOptions": {
      "type": "object",
      "properties": {
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DynamicOption"
          }
        },
        "warning": {
          "type": [
            "string",
            "null"
          ],
          "x-omit-none": true
        }
      },
      "additionalProperties": false,
      "required": [
        "options"
      ]
    },
    "DynamicOption": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "value",
        "label"
      ]
    },
    "OptionsRequest": {
      "type": "object",
      "properties": {
        "query": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "refresh": {
          "type": "boolean",
          "default": false
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      },
      "additionalProperties": false
    },
    "ConnectionCheckRequest": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/EndpointRole"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonObject"
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "role",
        "config"
      ]
    },
    "EndpointRole": {
      "type": "string",
      "enum": [
        "source",
        "sink"
      ]
    },
    "ConnectionCheckResult": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/ConnectionCheckStatus"
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "status",
        "options"
      ]
    },
    "ConnectionCheckStatus": {
      "type": "string",
      "enum": [
        "verified",
        "network_reachable"
      ]
    },
    "MessagePreviewRequest": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "additionalProperties": true,
          "x-typescript-type": "JsonObject"
        },
        "max_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "provider",
        "config",
        "max_bytes"
      ]
    },
    "MessagePreviewResult": {
      "type": "object",
      "properties": {
        "text_preview": {
          "type": "string"
        },
        "payload_preview_base64": {
          "type": "string"
        },
        "payload_base64": {
          "type": "string"
        },
        "byte_length": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "preview_bytes": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "metadata": {
          "$ref": "#/$defs/MessagePreviewMetadata"
        },
        "detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParserDetection"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "text_preview",
        "payload_preview_base64",
        "payload_base64",
        "byte_length",
        "preview_bytes",
        "metadata",
        "detections"
      ]
    },
    "MessagePreviewMetadata": {
      "type": "object",
      "properties": {
        "topic": {
          "type": "string"
        },
        "partition": {
          "type": "integer",
          "format": "int64"
        },
        "partition_session_id": {
          "type": "integer",
          "format": "int64"
        },
        "offset": {
          "type": "integer",
          "format": "int64"
        },
        "sequence_number": {
          "type": "integer",
          "format": "int64"
        },
        "created_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "written_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "producer_id": {
          "type": "string"
        },
        "message_group_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "codec": {
          "type": "string"
        },
        "compressed_size": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "declared_uncompressed_size": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "message_metadata": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessagePreviewMetadataItem"
          }
        },
        "write_session_metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "topic",
        "partition",
        "partition_session_id",
        "offset",
        "sequence_number",
        "producer_id",
        "codec",
        "compressed_size",
        "message_metadata",
        "write_session_metadata"
      ]
    },
    "MessagePreviewMetadataItem": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value_base64": {
          "type": "string"
        },
        "value_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "value_base64"
      ]
    },
    "ParserDetection": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "config": true,
        "inferred_columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InferredColumn"
          }
        },
        "sample_rows": {
          "type": "array",
          "items": true
        },
        "preview_tabs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ParserPreviewTab"
          }
        },
        "sampled_messages": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "sampled_rows": {

{
  "name": "transferia-control-plane-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "update:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:source": "npm run check:api && npm run check:architecture",
    "typecheck": "tsc --noEmit",
    "bundle": "node scripts/build.mjs",
    "build": "npm run check:source && npm run typecheck && npm run bundle",
    "pretest": "npm run check:source",
    "test": "vitest run",
    "test:transform-scroll": "node scripts/check-transform-scroll.mjs",
    "test:row-reorder": "node scripts/check-row-reorder.mjs",
    "test:parser-layout": "node scripts/check-parser-layout.mjs",
    "test:about-layout": "node scripts/check-about-layout.mjs",
    "test:data-viewer": "node scripts/check-source-data-viewer.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}

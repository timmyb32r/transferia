{
  "name": "transferia-control-plane-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "update:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/generate-api.mjs --check",
    "check:architecture": "node scripts/check-architecture.mjs",
    "build": "npm run check:api && npm run check:architecture && tsc --noEmit && node scripts/build.mjs",
    "pretest": "npm run check:api && npm run check:architecture",
    "test": "vitest run"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "esbuild": "0.28.2",
    "jsdom": "30.0.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}
